# Required: from your Slack app (see README)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Required: the only Slack member ID allowed to start threads (e.g. U012ABC3DEF)
# Slack: your profile > "..." > Copy member ID
ALLOWED_SLACK_USER_ID=

# Optional: project used when a message has no project: prefix.
# An absolute path, a T3 project id, or a folder name in T3_PROJECTS_DIR
T3_DEFAULT_PROJECT=

# Optional: parent folder for project:<name>, e.g. ~/dev makes project:api mean ~/dev/api
T3_PROJECTS_DIR=
